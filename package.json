{
  "name": "shipshape-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only GitHub portfolio maintenance priorities over MCP",
  "type": "module",
  "scripts": {
    "build": "cf build",
    "check": "pnpm types && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm dry-run",
    "deploy": "cf deploy",
    "deploy:ci": "cf deploy --prebuilt",
    "dev": "portless run vite",
    "dry-run": "cf deploy --dry-run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "preview": "cf previews deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "cf workers types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "^0.26.0",
    "jsonc-parser": "^3.3.1",
    "oauth4webapi": "^3.8.8",
    "octokit": "^5.0.5",
    "p-limit": "^7.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-805ec1ff3",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.4",
    "cf": "1.0.0-beta.12",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "portless": "0.15.7",
    "typescript": "7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
