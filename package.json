{
  "name": "shipshape-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only GitHub portfolio maintenance priorities over MCP",
  "type": "module",
  "scripts": {
    "check": "pnpm types && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm dry-run",
    "deploy": "wrangler deploy --minify",
    "dev": "wrangler dev",
    "dry-run": "wrangler deploy --dry-run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-file .dev.vars.example"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.22.0",
    "oauth4webapi": "^3.8.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "packageManager": "pnpm@12.2.1"
}
