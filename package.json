{
  "name": "shipshape-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only GitHub portfolio maintenance priorities over MCP",
  "type": "module",
  "scripts": {
    "build": "pnpm ui:build && cf build",
    "check": "pnpm types && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm dry-run",
    "deploy": "cf deploy",
    "deploy:ci": "cf deploy --prebuilt",
    "dev": "portless run vite",
    "dry-run": "pnpm ui:build && cf deploy --dry-run",
    "format": "oxfmt --config oxfmt.config.ts",
    "format:check": "oxfmt --config oxfmt.config.ts --check",
    "lint": "oxlint",
    "preview": "pnpm ui:build && cf previews deploy --mode preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "cf workers types",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "ui:dev": "vite --config vite.ui.config.ts",
    "ui:build": "vite build --config vite.ui.config.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "^0.28.1",
    "jsonc-parser": "^3.3.1",
    "oauth4webapi": "^3.8.8",
    "octokit": "^5.0.5",
    "p-limit": "^7.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.2.2",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-805ec1ff3",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@fontsource-variable/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "cf": "1.0.0-beta.17",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.8",
    "preact": "^11.0.1",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --config oxfmt.config.ts --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --config oxfmt.config.ts --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.11.2"
}
