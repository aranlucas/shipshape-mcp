{
  "name": "shipshape-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only GitHub portfolio maintenance priorities over MCP",
  "type": "module",
  "scripts": {
    "check": "pnpm types && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm dry-run",
    "deploy": "cf deploy",
    "dev": "cf dev",
    "dry-run": "cf deploy --dry-run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-file .dev.vars.example"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@modelcontextprotocol/server": "2.1.0",
    "agents": "^0.24.0",
    "jsonc-parser": "^3.3.1",
    "oauth4webapi": "^3.8.8",
    "octokit": "^5.0.5",
    "p-limit": "^7.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@oxlint/plugins": "1.85.0",
    "@types/node": "^26.6.3",
    "cf": "1.0.0-beta.10",
    "esbuild": "0.28.2",
    "miniflare": "5.20260930.0-alpha",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "7.0.2",
    "undici": "7.29.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@12.6.0"
}
